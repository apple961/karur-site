# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Capacitor native projects (do NOT commit) ---
/android/
/ios/

# --- Android signing + local machine config ---
*.jks
*.keystore
**/key.properties
/android/local.properties

# --- (Only matters if you ever unignore /android) ---
/android/.gradle/
/android/.idea/
/android/**/build/
/android/**/.cxx/

# --- Vite build output (in case your outDir is the default) ---
/dist
